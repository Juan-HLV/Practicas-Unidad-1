<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loadingFragment">

    <fragment
        android:id="@+id/loadingFragment"
        android:name="com.example.exame_u3.ui.LoadingFragment"
        android:label="Loading"
        tools:layout="@layout/fragment_loading">
        <action
            android:id="@+id/action_loadingFragment_to_listFragment"
            app:destination="@id/listFragment"
            app:popUpTo="@id/loadingFragment"
            app:popUpToInclusive="true" />
    </fragment>
    
    <fragment
        android:id="@+id/listFragment"
        android:name="com.example.exame_u3.ui.ListFragment"
        android:label="Pokémon List"
        tools:layout="@layout/fragment_list">
        <action
            android:id="@+id/action_listFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
    </fragment>
    
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.exame_u3.ui.SearchFragment"
        android:label="Search Pokémon"
        tools:layout="@layout/fragment_search">
         <action
            android:id="@+id/action_searchFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
    </fragment>
    
    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.example.exame_u3.ui.FavoritesFragment"
        android:label="Favorites"
        tools:layout="@layout/fragment_favorites">
         <action
            android:id="@+id/action_favoritesFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
    </fragment>

    <fragment
        android:id="@+id/detailFragment"
        android:name="com.example.exame_u3.ui.DetailFragment"
        android:label="Detail"
        tools:layout="@layout/fragment_detail">
        <argument
            android:name="pokemonName"
            app:argType="string" />
    </fragment>
</navigation>
